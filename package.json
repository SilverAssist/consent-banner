{
  "name": "@silverassist/consent-banner",
  "version": "0.1.3",
  "description": "A flexible, accessible consent banner component for React. Perfect for GDPR cookie consent, privacy policy updates, and other user notifications.",
  "author": "Miguel Colmenares <me@miguelcolmenares.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "prettier": "@silverassist/npm-package-standards/prettier",
  "homepage": "https://github.com/SilverAssist/consent-banner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverAssist/consent-banner.git"
  },
  "bugs": {
    "url": "https://github.com/SilverAssist/consent-banner/issues"
  },
  "keywords": [
    "react",
    "consent",
    "cookie",
    "gdpr",
    "banner",
    "nextjs",
    "tailwind",
    "shadcn",
    "accessibility",
    "privacy"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles": {
      "import": "./dist/styles.css",
      "require": "./dist/styles.css"
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run check && npm run build",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "prepare": "husky || true",
    "e2e:setup": "next-testing-toolkit build-fixture --port 3211 --layout-import @silverassist/consent-banner/styles",
    "e2e": "npm run e2e:setup && playwright test -c e2e/playwright.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "class-variance-authority": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@silverassist/next-testing-toolkit": "^0.2.1",
    "@silverassist/npm-package-standards": "^0.1.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks-extra": "^2.13.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks-extra": {
      "typescript": "$typescript"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
